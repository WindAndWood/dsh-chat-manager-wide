{
  "name": "dsh-chat-manager-wide",
  "version": "1.5.1",
  "description": "DeepSeek Harness session management (unofficial fork of dsh-chat-manager, not affiliated with DeepSeek or the upstream author): an official-slot plugin for dsh >= 0.2.0-rc.2 that reads archived conversations in place and permanently deletes sessions",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/client.js",
    "scripts/build-client.mjs",
    "src/client/factory.js",
    "src/index.js",
    "src/host/archive-manager.mjs",
    "src/host/delete-session.mjs",
    "src/host/same-origin.mjs",
    "docs/assets",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "PUBLISH.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-manager",
    "session-management",
    "conversation",
    "archive",
    "unarchive",
    "restore",
    "history-search",
    "chat-history",
    "conversation-history",
    "archived-sessions",
    "session-delete",
    "permanent-delete",
    "deepseek",
    "delete",
    "privacy",
    "fork",
    "archived-conversation",
    "conversation-viewer"
  ],
  "author": "windandwood <liangjinzhou22@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WindAndWood/dsh-chat-manager-wide.git"
  },
  "bugs": {
    "url": "https://github.com/WindAndWood/dsh-chat-manager-wide/issues"
  },
  "homepage": "https://github.com/WindAndWood/dsh-chat-manager-wide#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
